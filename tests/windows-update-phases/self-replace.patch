+const ERROR_SHARING_VIOLATION: i32 = 32;
+const FILE_READ_ATTRIBUTES: u32 = 0x80;
+const FILE_SHARE_ALL: u32 = 7;
+const FILE_PROCESS_IDS_USING_FILE_INFORMATION: u32 = 47;
+const PROCESS_QUERY_LIMITED_INFORMATION: u32 = 0x1000;
+
+// A step that succeeds returns at once: logging it could give a short-lived holder time to let go.
+fn phase<T>(name: &str, paths: &[&Path], result: io::Result<T>) -> io::Result<T> {
+    if let Err(e) = &result {
+        report(name, paths, e);
+    }
+    result
+}
+
+fn report(name: &str, paths: &[&Path], error: &io::Error) {
+    let outcome = match error.raw_os_error() {
+        Some(code) => format!("os error {}", code),
+        None => format!("{:?}", error.kind()),
+    };
+    let names: Vec<_> = paths.iter().map(|path| basename(path)).collect();
+    eprintln!(
+        "self-replace phase {}: {} [{}]",
+        name,
+        outcome,
+        names.join(" -> ")
+    );
+    if error.raw_os_error() == Some(ERROR_SHARING_VIOLATION) {
+        for path in paths {
+            eprintln!(
+                "self-replace holders of {} (self {}): {}",
+                basename(path),
+                std::process::id(),
+                holders(path)
+            );
+        }
+    }
+}
+
+fn basename(path: &Path) -> String {
+    path.file_name()
+        .map(|name| name.to_string_lossy().into_owned())
+        .unwrap_or_default()
+}
+
+// The processes with `path` open, by image name only; attributes-only access never conflicts.
+fn holders(path: &Path) -> String {
+    use std::os::windows::fs::OpenOptionsExt;
+    use std::os::windows::io::AsRawHandle;
+
+    let file = match fs::OpenOptions::new()
+        .access_mode(FILE_READ_ATTRIBUTES)
+        .share_mode(FILE_SHARE_ALL)
+        .open(path)
+    {
+        Ok(file) => file,
+        Err(e) => return format!("not opened: os error {:?}", e.raw_os_error()),
+    };
+    // FILE_PROCESS_IDS_USING_FILE_INFORMATION: a count, then the ids.
+    let mut ids = [0usize; 65];
+    let mut status_block = [0usize; 2];
+    let status = unsafe {
+        NtQueryInformationFile(
+            file.as_raw_handle(),
+            &mut status_block,
+            ids.as_mut_ptr().cast(),
+            mem::size_of_val(&ids) as u32,
+            FILE_PROCESS_IDS_USING_FILE_INFORMATION,
+        )
+    };
+    if status < 0 {
+        return format!("not queried: ntstatus {:#x}", status);
+    }
+    let count = (ids[0] as u32 as usize).min(ids.len() - 1);
+    ids[1..=count]
+        .iter()
+        .map(|&pid| format!("{}:{}", pid, image_name(pid as u32)))
+        .collect::<Vec<_>>()
+        .join(" ")
+}
+
+fn image_name(pid: u32) -> String {
+    use std::os::windows::io::{AsRawHandle, FromRawHandle, OwnedHandle};
+
+    let process = unsafe { OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, 0, pid) };
+    if process.is_null() {
+        return format!("? os error {:?}", io::Error::last_os_error().raw_os_error());
+    }
+    let process = unsafe { OwnedHandle::from_raw_handle(process) };
+    let mut name = [0u16; 1024];
+    let mut length = name.len() as u32;
+    let named = unsafe {
+        QueryFullProcessImageNameW(process.as_raw_handle(), 0, name.as_mut_ptr(), &mut length)
+    };
+    if named == 0 {
+        return format!("? os error {:?}", io::Error::last_os_error().raw_os_error());
+    }
+    basename(Path::new(&String::from_utf16_lossy(
+        &name[..length as usize],
+    )))
+}
